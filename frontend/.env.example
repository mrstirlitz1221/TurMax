# Адрес ASP.NET Core API (используется сервером Next.js для SSR и прокси /api/*)
API_INTERNAL_URL=http://localhost:5199
# Публичный адрес сайта — для sitemap, canonical и Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Сервер тайлов карты (п. 2.2 диплома: адрес вынесен в настройки)
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
